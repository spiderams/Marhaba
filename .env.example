# URL du backend TaxiDjibouti. Copier ce fichier en ".env" et ajuster selon la cible :
#   - Web (navigateur du PC)            → https://localhost:7129
#   - Émulateur Android                 → https://10.0.2.2:7129
#   - Téléphone physique (même Wi-Fi)   → https://192.168.x.x:7129 (IP LAN du PC)
EXPO_PUBLIC_API_BASE_URL=https://localhost:7129
